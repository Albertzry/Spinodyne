# Optional overrides. Defaults are loaded from project root config.json (Spinodyne/config.json).
# Set CONFIG_FILE to use another config file path (absolute or relative to backend/).

# CONFIG_FILE=../config.json

# Database (override config.json postgres)
# POSTGRES_URL=postgresql://postgres:password123@localhost:5432/spinodyne

# Redis (override config.json redis)
# REDIS_URL=redis://127.0.0.1:25698/0

# MinIO (override config.json minio)
# MINIO_ENDPOINT=localhost:25957
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=spinodyne

# Backend server (override config.json backend)
# BACKEND_HOST=0.0.0.0
# BACKEND_PORT=25306
